# Example environment variables for local development and Vercel.
# Copy this file to `.env.local` and fill in secrets. Do NOT commit `.env.local`.

# Vite (client-side build-time) vars (prefixed with VITE_ to embed in client bundle)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_anon_publishable_key

# Server/runtime vars (do NOT expose these to the client)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# OpenRouter (primary server-side LLM provider)
OPENROUTER_API_KEY=or-your-openrouter-key
OPENROUTER_MODEL=gpt-4o-mini
OPENROUTER_API_BASE=https://openrouter.ai/api

# Google Gemini (fallback)
GOOGLE_GEMINI_API_KEY=
GOOGLE_GEMINI_MODEL=models/text-bison-001
GOOGLE_GEMINI_API_BASE=https://gemini.googleapis.com

# Groq (fallback)
GROQ_API_KEY=
GROQ_MODEL=groq-alpha:latest
GROQ_API_BASE=https://api.groq.ai/v1

# Hugging Face (fallback)
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=gpt2
HUGGINGFACE_API_BASE=https://api-inference.huggingface.co
